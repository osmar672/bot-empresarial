{
  "name": "@policybot/backend",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "doctor": "node src/db/doctor.js",
    "seed": "node src/db/seedDemo.js",
    "seed:collaborators": "node src/db/seedCollaborators.js",
    "seed:attendance": "node src/db/seedAttendanceDemo.js",
    "test": "node --test tests/*.test.js",
    "predev": "node ../scripts/ensure-dependencies.mjs --backend",
    "prestart": "node ../scripts/ensure-dependencies.mjs --backend",
    "premigrate": "node ../scripts/ensure-dependencies.mjs --backend",
    "predoctor": "node ../scripts/ensure-dependencies.mjs --backend",
    "preseed": "node ../scripts/ensure-dependencies.mjs --backend",
    "db:migrate": "node src/db/migrate.js",
    "db:photos": "npm --prefix .. run db:photos",
    "setup": "npm --prefix .. run setup",
    "predb:migrate": "node ../scripts/ensure-dependencies.mjs --backend"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/lib-storage": "^3.1172.0",
    "@napi-rs/canvas": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "google-auth-library": "^11.3.4",
    "googleapis": "^189.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "mysql2": "^3.14.3",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
