# Plantilla de configuración (Copiar a backend/.env)
PORT=4000
NODE_ENV=development

# MySQL (puerto 3306 habitual en Windows local, o 3307 si usas Docker)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_contraseña_mysql
MYSQL_DATABASE=policybot

# Clave secreta JWT (mínimo 32 caracteres)
JWT_SECRET=reemplaza_esta_cadena_por_un_secreto_seguro_de_mas_de_32_caracteres_aleatorios_12345

# Proveedor LLM Groq (https://console.groq.com/keys)
GROQ_API_KEY=tu_clave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: 'local' (sin costo) o 'voyage'
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# Inicio de sesión con Google (ID público de cliente OAuth web)
GOOGLE_CLIENT_ID=902652626944-svt8298m9edpviujiejn9nk7fpgukhju.apps.googleusercontent.com

# Google Drive (cuenta de servicio)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
SYNC_CRON=*/5 * * * *

# Parámetros y seguridad
MAX_UPLOAD_MB=1024
DEMO_PASSWORD=DemoSeguro2026!

# Correo transaccional: smtp, resend o gmail. Configura el proveedor elegido.
MAIL_PROVIDER=smtp

# SMTP tradicional (Gmail con contraseña de app, Mailgun, SendGrid, Amazon SES, relay local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=Luma <tu_correo@gmail.com>

# Gmail API (completar en .env privado y cambiar MAIL_PROVIDER a gmail)
GMAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Resend (remitente verificado, valores solo en .env privado)
RESEND_API_KEY=
MAIL_FROM=

# URL pública para enlaces de recuperación/verificación (HTTPS en producción)
PUBLIC_APP_URL=http://127.0.0.1:5173
# Respaldos cifrados: activa solo tras configurar clave y almacenamiento privado
BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=./backups
BACKUP_CRON=15 3 * * *
BACKUP_RETENTION_DAYS=14

# Copias externas opcionales: none, s3 o gcs. Solo se envían archivos cifrados.
BACKUP_EXTERNAL_PROVIDER=none
BACKUP_EXTERNAL_BUCKET=
BACKUP_EXTERNAL_PREFIX=luma
BACKUP_EXTERNAL_VERIFY_CRON=30 4 * * 0
# S3/compatibles: credenciales privadas o rol IAM del servidor
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# GCS usa GOOGLE_APPLICATION_CREDENTIALS con permisos sobre el bucket privado.

# CORS: orígenes exactos separados por comas, sin rutas ni comodines.
# En producción PUBLIC_APP_URL debe ser el origen HTTPS público.
CORS_ORIGINS=
