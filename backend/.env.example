# Configuración general del servidor
PORT=4000
NODE_ENV=development

# MySQL (puerto 3306 habitual en Windows local, o 3307 si usas el docker-compose incluido)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=policybot
MYSQL_PASSWORD=policybot_local
MYSQL_DATABASE=tablero

# Clave secreta JWT (mínimo 32 caracteres)
JWT_SECRET=reemplaza_esta_cadena_por_un_secreto_seguro_de_mas_de_32_caracteres_aleatorios_12345

# Proveedor LLM Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: 'local' (hashing léxico local, sin costo) o 'voyage' (semántico)
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# Google Drive (cuenta de servicio)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
SYNC_CRON=0 * * * *

# Parámetros y seguridad
MAX_UPLOAD_MB=1024
DEMO_PASSWORD=DemoSeguro2026!

# Correo de bienvenida (Resend; remitente verificado, valores solo en .env privado)
RESEND_API_KEY=
MAIL_FROM=
