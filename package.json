{
  "name": "policybot-mysql-groq-drive",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "npm run migrate -w backend",
    "db:doctor": "npm run doctor -w backend",
    "db:status": "npm run migrate -w backend -- --status",
    "db:dry-run": "npm run migrate -w backend -- --dry-run",
    "db:seed": "npm run seed -w backend",
    "db:seed:collaborators": "node backend/src/db/seedCollaborators.js",
    "test": "npm run test -w backend",
    "smoke": "node scripts/smoke-api.mjs",
    "test:integration": "node --test scripts/access.integration.mjs",
    "test:files": "node scripts/profile-files.integration.mjs",
    "test:attendance": "node scripts/attendance.integration.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
