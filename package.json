{
  "name": "policybot-mysql-groq-drive",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:photos": "node backend/src/db/setupProfilePhotos.js",
    "db:migrate": "node backend/src/db/migrate.js",
    "db:doctor": "npm run doctor -w backend",
    "db:status": "node backend/src/db/migrate.js --status",
    "db:dry-run": "node backend/src/db/migrate.js --dry-run",
    "db:seed": "npm run seed -w backend",
    "db:seed:collaborators": "node backend/src/db/seedCollaborators.js",
    "test": "npm run test -w backend",
    "smoke": "node scripts/smoke-api.mjs",
    "test:integration": "node --test scripts/access.integration.mjs",
    "test:files": "node scripts/profile-files.integration.mjs",
    "test:attendance": "node scripts/attendance.integration.mjs",
    "test:profile-photo": "node scripts/profile-photo.integration.mjs",
    "test:workforce": "node scripts/workforce.integration.mjs",
    "db:seed:team": "node backend/src/db/seedTeam.js",
    "setup": "node scripts/install-dependencies.mjs && node scripts/ensure-dependencies.mjs --check",
    "check:install": "node scripts/ensure-dependencies.mjs --check",
    "predev": "node scripts/ensure-dependencies.mjs",
    "prestart": "node scripts/ensure-dependencies.mjs --backend",
    "prebuild": "node scripts/ensure-dependencies.mjs --frontend",
    "predb:photos": "node scripts/ensure-dependencies.mjs --backend",
    "predb:migrate": "node scripts/ensure-dependencies.mjs --backend",
    "predb:status": "node scripts/ensure-dependencies.mjs --backend",
    "predb:dry-run": "node scripts/ensure-dependencies.mjs --backend",
    "test:profile-customization": "node scripts/profile-customization.integration.mjs",
    "backup": "node scripts/database-backup.mjs",
    "test:operations": "node scripts/operations.integration.mjs",
    "mail:test": "node scripts/mail-test.mjs",
    "test:people-tools": "node scripts/people-tools.integration.mjs",
    "test:ocr": "node scripts/ocr.integration.mjs",
    "test:backup-restore": "node scripts/backup-restore.integration.mjs",
    "test:security-mail": "node scripts/security-mail.integration.mjs",
    "test:workflows": "node scripts/workflows.integration.mjs",
    "test:external-backup": "node scripts/external-backup.integration.mjs",
    "test:security": "node --test backend/tests/request-security.test.js backend/tests/xss-rendering.test.js backend/tests/csrf-client.test.js",
    "security:lab": "node scripts/security-sql-lab.mjs --local-lab",
    "test:security:integration": "node --test scripts/security.integration.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
